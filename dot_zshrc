# env variable
export ZSH="$HOME/.oh-my-zsh"
export EDITOR="/usr/bin/vim"
export PATH="$HOME/.local/bin:$PATH"
export LC_ALL="en_US.UTF-8"
export HOMEBREW_NO_AUTO_UPDATE=1

# theme
ZSH_THEME="blinks"

# Plugins
plugins=(zsh-autosuggestions zsh-syntax-highlighting docker docker-compose)

# Path to oh-my-zsh 
source $ZSH/oh-my-zsh.sh

# Enable docker auto complete
zstyle ':completion:*:*:docker:*' option-stacking yes
zstyle ':completion:*:*:docker-*:*' option-stacking yes

# Keyboard delay 1/100 sec
KEYTIMEOUT=4

# alias
alias h="history"
alias glo="git log --oneline --graph --all --decorate"
alias hide-dirty='git config --add oh-my-zsh.hide-dirty 1'
alias bat='batcat'

# fzf
[ -f ~/.fzf.zsh ] && source ~/.fzf.zsh

# zoxide
eval "$(zoxide init zsh)"
